rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Billing Documents (Invoices, Challans, Proformas)
    match /documents/{documentId} {
      allow read, write: if true;
    }

    // Clients
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // Catalog & Items
    match /items/{itemId} {
      allow read, write: if true;
    }

    // Product lists
    match /productLists/{listId} {
      allow read, write: if true;
    }

    // Companies
    match /companies/{companyId} {
      allow read, write: if true;
    }

    // Currencies
    match /currencies/{currencyId} {
      allow read, write: if true;
    }

    // Staff
    match /staff/{staffId} {
      allow read, write: if true;
    }
  }
}
